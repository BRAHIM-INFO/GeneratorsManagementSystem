@model List<GeneratorsManagementSystem.Models.Fuel.FuelConsumption>
@{
    ViewData["Title"] = "سجل استهلاك الوقود";
    var generators = ViewBag.Generators as List<GeneratorsManagementSystem.Models.Generator>;
    var startDate = ViewBag.StartDate as DateTime?;
    var endDate = ViewBag.EndDate as DateTime?;
    var genFilter = ViewBag.GeneratorId as int?;
}

@section Styles {
    <style>
        .en-numbers {
            direction: ltr;
            display: inline-block;
            font-feature-settings: "tnum";
        }

        .filter-bar {
            background: linear-gradient(135deg, #FFF5F5 0%, #FED7D7 100%);
            border-radius: 15px;
            padding: 20px;
        }

        .btn-action-sm {
            width: 32px;
            height: 32px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
        }
    </style>
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-800 mb-1">
            <i class="fas fa-tint text-danger me-2"></i>
            سجل استهلاك الوقود
        </h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">الوقود</a></li>
                <li class="breadcrumb-item active">الاستهلاك</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-outline-primary">
            <i class="fas fa-arrow-right me-2"></i>لوحة الوقود
        </a>
        <button class="btn btn-danger" id="btnAddConsumption">
            <i class="fas fa-plus me-2"></i>تسجيل استهلاك
        </button>
    </div>
</div>

<!-- Filter -->
<div class="filter-bar shadow-sm mb-4">
    <form method="get" action="@Url.Action("Consumptions")" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-bold small">من تاريخ</label>
            <input type="date" name="startDate" value="@(startDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold small">إلى تاريخ</label>
            <input type="date" name="endDate" value="@(endDate?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold small">المولد</label>
            <select name="generatorId" class="form-select">
                <option value="">كل المولدات</option>
                @foreach (var g in generators ?? new())
                {
                    <option value="@g.Id" selected="@(genFilter == g.Id)">
                        @g.GeneratorNumber - @g.Name
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger flex-grow-1">
                    <i class="fas fa-filter me-1"></i>تطبيق
                </button>
                <a href="@Url.Action("Consumptions")" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3 bg-danger bg-opacity-10">
            <small class="text-muted">إجمالي المستهلك</small>
            <h3 class="fw-900 text-danger mb-0 en-numbers">
                @Model.Sum(c => c.Quantity).ToString("N2")
            </h3>
            <small class="text-muted">لتر</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3 bg-warning bg-opacity-10">
            <small class="text-muted">إجمالي التكلفة</small>
            <h3 class="fw-900 text-warning mb-0 en-numbers">
                @Model.Sum(c => c.Cost).ToString("N0")
            </h3>
            <small class="text-muted">د.ع</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3 bg-primary bg-opacity-10">
            <small class="text-muted">عدد السجلات</small>
            <h3 class="fw-900 text-primary mb-0 en-numbers">@Model.Count</h3>
            <small class="text-muted">سجل</small>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold">
            <i class="fas fa-history me-2 text-danger"></i>
            سجل الاستهلاك
            <span class="badge bg-danger ms-2 en-numbers">@Model.Count</span>
        </h6>
    </div>
    <div class="card-body p-3">
        <table id="consumptionsTable" class="table table-hover align-middle" style="width:100%">
            <thead class="table-light">
                <tr>
                    <th>الرقم</th>
                    <th>التاريخ</th>
                    <th>المولد</th>
                    <th>النوع</th>
                    <th>الكمية</th>
                    <th>التكلفة</th>
                    <th>الحصة</th>
                    <th>الطريقة</th>
                    <th>المسؤول</th>
                    <th class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cons in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-light text-danger font-monospace en-numbers">
                                @cons.ConsumptionNumber
                            </span>
                        </td>
                        <td>
                            <small class="en-numbers">
                                @cons.ConsumptionDate.ToString("yyyy/MM/dd HH:mm")
                            </small>
                        </td>
                        <td>
                            <strong>@cons.Generator?.Name</strong>
                            <br>
                            <small class="text-muted font-monospace en-numbers">
                                @cons.Generator?.GeneratorNumber
                            </small>
                        </td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-25 text-dark">
                                @cons.FuelKindText
                            </span>
                        </td>
                        <td>
                            <strong class="text-danger en-numbers fs-5">
                                @cons.Quantity.ToString("N2")
                            </strong>
                            <small class="text-muted">لتر</small>
                        </td>
                        <td>
                            @if (cons.Cost > 0)
                            {
                                <strong class="en-numbers">@cons.Cost.ToString("N0")</strong>
                                <small class="text-muted">د.ع</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (cons.FuelAllocation != null)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success font-monospace en-numbers">
                                    @cons.FuelAllocation.AllocationNumber
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge @cons.MethodBadgeClass">
                                @cons.MethodText
                            </span>
                        </td>
                        <td>
                            <small>@(cons.FilledBy ?? "—")</small>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-outline-danger btn-action-sm btn-delete"
                                    data-id="@cons.Id"
                                    data-number="@cons.ConsumptionNumber"
                                    title="حذف">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="consumptionModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" id="modalContent"></div>
    </div>
</div>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#consumptionsTable').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/ar.json" },
                order: [[1, 'desc']],
                pageLength: 25,
                responsive: true
            });

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            document.getElementById('btnAddConsumption').addEventListener('click', function() {
                loadModal('@Url.Action("CreateConsumption")');
            });

            function loadModal(url) {
                document.getElementById('modalContent').innerHTML = `
                            <div class="modal-body text-center py-5">
                                <div class="spinner-border text-primary"></div>
                                <p class="mt-3">جارِ التحميل...</p>
                            </div>`;
                var modal = new bootstrap.Modal(document.getElementById('consumptionModal'));
                modal.show();

                fetch(url)
                    .then(r => r.text())
                    .then(html => {
                        document.getElementById('modalContent').innerHTML = html;
                        initForm();
                    });
            }

            function initForm() {
                var form = document.getElementById('fuelForm');
                if (!form) return;

                // عند تغيير نوع الوقود، اجلب الحصص المتاحة
                var fuelKindSelect = form.querySelector('[name="FuelKind"]');
                var allocationSelect = form.querySelector('[name="FuelAllocationId"]');

                fuelKindSelect?.addEventListener('change', function() {
                    loadAvailableAllocations(this.value);
                });

                function loadAvailableAllocations(fuelKind) {
                    fetch('@Url.Action("GetAvailableAllocations")?fuelKind=' + fuelKind)
                        .then(r => r.json())
                        .then(allocations => {
                            allocationSelect.innerHTML = '<option value="">-- بدون ربط بحصة --</option>';
                            allocations.forEach(a => {
                                var opt = document.createElement('option');
                                opt.value = a.id;
                                opt.textContent = a.display;
                                allocationSelect.appendChild(opt);
                            });
                        });
                }

                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    var btn = form.querySelector('[type="submit"]');
                    var original = btn.innerHTML;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>جارِ الحفظ...';
                    btn.disabled = true;

                    fetch(form.getAttribute('action'), {
                        method: 'POST', body: new FormData(form)
                    })
                        .then(r => r.json())
                        .then(res => {
                            if (res.success) {
                                bootstrap.Modal.getInstance(document.getElementById('consumptionModal')).hide();
                                Swal.fire({
                                    icon: 'success', title: 'تم', text: res.message,
                                    timer: 2000, customClass: { popup: 'swal2-rtl' }
                                }).then(() => location.reload());
                            } else {
                                var errHtml = res.errors?.length ? '<ul class="text-start mt-2">' + res.errors.map(e => `<li>${e}</li>`).join('') + '</ul>' : '';
                                Swal.fire({
                                    icon: 'error', title: 'فشل', html: res.message + errHtml,
                                    customClass: { popup: 'swal2-rtl' }
                                });
                                btn.innerHTML = original;
                                btn.disabled = false;
                            }
                        });
                });
            }

            $(document).on('click', '.btn-delete', function() {
                var id = $(this).data('id');
                var num = $(this).data('number');

                Swal.fire({
                    icon: 'warning', title: 'تأكيد الحذف',
                    html: `هل تريد حذف السجل <strong>${num}</strong>؟`,
                    showCancelButton: true,
                    confirmButtonText: 'حذف', cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#dc3545',
                    customClass: { popup: 'swal2-rtl' }
                }).then(res => {
                    if (res.isConfirmed) {
                        $.post('@Url.Action("DeleteConsumption")', {
                            id: id, __RequestVerificationToken: token
                        }, function(r) {
                            Swal.fire({
                                icon: r.success ? 'success' : 'error',
                                title: r.success ? 'تم' : 'فشل',
                                text: r.message, timer: 1500,
                                customClass: { popup: 'swal2-rtl' }
                            }).then(() => r.success && location.reload());
                        });
                    }
                });
            });
        });
    </script>
}