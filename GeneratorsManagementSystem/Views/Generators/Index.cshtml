                // ═══ تنفيذ الحذف مع معالجة الأخطاء ═══
                function performDelete(id, name, number) {
                    // Loading
                    Swal.fire({
                        title: 'جارِ المعالجة...',
                        html: 'يرجى الانتظار',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        showConfirmButton: false,
                        customClass: { popup: 'swal2-rtl' },
                        didOpen: () => Swal.showLoading()
                    });

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                    fetch('@Url.Action("Delete")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `id=${id}&__RequestVerificationToken=${encodeURIComponent(token)}`
                    })
                        .then(r => r.json())
                        .then(res => {
                            // ✅ الحذف نجح
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'تم الحذف بنجاح',
                                    text: res.message,
                                    timer: 2000,
                                    timerProgressBar: true,
                                    customClass: { popup: 'swal2-rtl' }
                                }).then(() => location.reload());
                                return;
                            }

                            // ⚠️ يوجد اشتراكات نشطة
                            if (res.errorType === 'hasActiveSubscriptions') {
                                showActiveSubscriptionsDialog(res.details, id);
                                return;
                            }

                            // ❌ خطأ عام
                            Swal.fire({
                                icon: 'error',
                                title: 'فشل الحذف',
                                text: res.message,
                                confirmButtonColor: '#dc3545',
                                customClass: { popup: 'swal2-rtl' }
                            });
                        })
                        .catch(() => {
                            Swal.fire({
                                icon: 'error',
                                title: 'خطأ في الاتصال',
                                text: 'تعذر الاتصال بالخادم. حاول مرة أخرى.',
                                customClass: { popup: 'swal2-rtl' }
                            });
                        });
                }

