            }).then((result) => {
                if (result.isConfirmed) {
                    // انتقل لصفحة الاشتراكات مفلترة بهذا المولد
                    window.location.href = '/Subscriptions?generatorId=' + generatorId;
                }
            });
        } 
            
        });
    </script>
}