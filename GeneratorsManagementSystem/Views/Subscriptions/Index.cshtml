                        //             customClass: { popup: 'swal2-rtl' }
                        //         });
                        //         $btn.html(originalText).prop('disabled', false);
                        //     }
                        // },
                        error: function () {
                            Swal.fire({ icon: 'error', title: 'خطأ', text: 'تعذر الاتصال' });
                            $btn.html(originalText).prop('disabled', false);
                        }
                    });
                });
            }

            // ═══ إيقاف مؤقت ═══
            $(document).on('click', '.btn-suspend', function () {
                var id = $(this).data('id');
                Swal.fire({
                    icon: 'warning', title: 'إيقاف العقد',
                    text: 'أدخل سبب الإيقاف:',
                    input: 'textarea',
                    showCancelButton: true,
                    confirmButtonText: 'إيقاف', cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#D69E2E',
                    customClass: { popup: 'swal2-rtl' }
                }).then(res => {
                    if (res.isConfirmed) {
                        $.post('@Url.Action("Suspend")', {
                            id: id, reason: res.value || '',
                            __RequestVerificationToken: token
                        }, function (r) {
                            Swal.fire({
                                icon: r.success ? 'success' : 'error',
                                title: r.success ? 'تم' : 'فشل',
                                text: r.message, timer: 1500,
                                customClass: { popup: 'swal2-rtl' }
                            }).then(() => r.success && location.reload());
                        });
                    }
                });
            });

            // ═══ إعادة تفعيل ═══
            $(document).on('click', '.btn-reactivate', function () {
                var id = $(this).data('id');
                Swal.fire({
                    icon: 'question', title: 'إعادة تفعيل',
                    text: 'هل تريد إعادة تفعيل هذا العقد؟',
                    showCancelButton: true,
                    confirmButtonText: 'نعم', cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#48BB78',
                    customClass: { popup: 'swal2-rtl' }
                }).then(res => {
                    if (res.isConfirmed) {
                        $.post('@Url.Action("Reactivate")', {
                            id: id, __RequestVerificationToken: token
                        }, function (r) {
                            Swal.fire({
                                icon: r.success ? 'success' : 'error',
                                title: r.success ? 'تم' : 'فشل',
                                text: r.message, timer: 1500,
                                customClass: { popup: 'swal2-rtl' }
                            }).then(() => r.success && location.reload());
                        });
                    }
                });
            });

            // ═══ إلغاء ═══
            $(document).on('click', '.btn-cancel', function () {
                var id = $(this).data('id');
                Swal.fire({
                    icon: 'warning', title: 'إلغاء العقد',
                    text: 'أدخل سبب الإلغاء:', input: 'textarea',
                    showCancelButton: true,
                    confirmButtonText: 'إلغاء العقد', cancelButtonText: 'تراجع',
                    confirmButtonColor: '#dc3545',
                    customClass: { popup: 'swal2-rtl' }
                }).then(res => {
                    if (res.isConfirmed) {
                        $.post('@Url.Action("Cancel")', {
                            id: id, reason: res.value || '',
                            __RequestVerificationToken: token
                        }, function (r) {
                            Swal.fire({
                                icon: r.success ? 'success' : 'error',
                                title: r.success ? 'تم' : 'فشل',
                                text: r.message, timer: 1500,
                                customClass: { popup: 'swal2-rtl' }
                            }).then(() => r.success && location.reload());
                        });
                    }
                });
            });

            // ═══ حذف ═══
            $(document).on('click', '.btn-delete', function () {
                var id = $(this).data('id');
                var num = $(this).data('number');
                Swal.fire({
                    icon: 'warning', title: 'تأكيد الحذف',
                    html: `هل تريد حذف العقد <strong>${num}</strong>؟<br/><small class="text-danger">لا يمكن التراجع</small>`,
                    showCancelButton: true,
                    confirmButtonText: 'حذف', cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#dc3545',
                    customClass: { popup: 'swal2-rtl' }
                }).then(res => {
                    if (res.isConfirmed) {
                        $.post('@Url.Action("Delete")', {
                            id: id, __RequestVerificationToken: token
                        }, function (r) {
                            Swal.fire({
                                icon: r.success ? 'success' : 'error',
                                title: r.success ? 'تم' : 'فشل',
                                text: r.message, timer: 1500,
                                customClass: { popup: 'swal2-rtl' }
                            }).then(() => r.success && location.reload());
                        });
                    }
                });
            });

        // تفعيل Tooltips
        setTimeout(function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }, 100);

        // إعادة تفعيل عند فتح Modal
        $(document).on('shown.bs.modal', '#subscriptionModal', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
     });
    </script>
