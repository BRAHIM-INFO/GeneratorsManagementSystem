@model GeneratorsManagementSystem.Models.Subscription
@{
    ViewData["Title"] = $"العقد {Model.ContractNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-800 mb-1">
            <i class="fas fa-file-contract text-primary me-2"></i>
            تفاصيل العقد
        </h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Dashboard")"><i class="fas fa-home"></i></a>
                </li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">الاشتراكات</a></li>
                <li class="breadcrumb-item active">@Model.ContractNumber</li>
            </ol>
        </nav>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right me-2"></i>رجوع
    </a>
</div>

<!-- بطاقة رئيسية -->
<div class="card border-0 shadow mb-4" style="background:linear-gradient(135deg,#5A67D8,#7886E0)">
    <div class="card-body text-white p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="bg-white bg-opacity-25 rounded-3 p-3">
                        <i class="fas fa-file-contract fa-2x"></i>
                    </div>
                    <div>
                        <h3 class="fw-900 mb-1 font-monospace">@Model.ContractNumber</h3>
                        <span class="badge bg-white text-primary fw-bold py-2 px-3">
                            @Model.StatusText
                        </span>
                    </div>
                </div>
                <div class="opacity-75 mt-3">
                    <i class="fas fa-calendar-alt me-1"></i>
                    تاريخ البداية: @Model.StartDate.ToString("yyyy/MM/dd")
                    @if (Model.EndDate.HasValue)
                    {
                        <span class="ms-3">
                            <i class="fas fa-calendar-check me-1"></i>
                            تاريخ الانتهاء: @Model.EndDate.Value.ToString("yyyy/MM/dd")
                        </span>
                    }
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="bg-white bg-opacity-25 rounded-3 p-3">
                    <small class="d-block">المبلغ الشهري</small>
                    <h2 class="fw-900 mb-0">@Model.MonthlyAmount.ToString("N0")</h2>
                    <small>د.ع</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- المشترك -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-user text-primary me-2"></i>المشترك
                </h6>
            </div>
            <div class="card-body">
                <h5 class="fw-bold">@Model.Subscriber?.FullName</h5>
                <p class="text-muted mb-2 font-monospace">@Model.Subscriber?.SubscriberNumber</p>
                @if (!string.IsNullOrEmpty(Model.Subscriber?.Phone))
                {
                    <p class="mb-1">
                        <i class="fas fa-phone text-success me-2"></i>
                        <span dir="ltr">@Model.Subscriber.Phone</span>
                    </p>
                }
                @if (!string.IsNullOrEmpty(Model.Subscriber?.FullAddress) && Model.Subscriber.FullAddress != "—")
                {
                    <p class="mb-0">
                        <i class="fas fa-map-marker-alt text-danger me-2"></i>
                        @Model.Subscriber.FullAddress
                    </p>
                }
                <a href="@Url.Action("Details", "Subscribers", new { id = Model.SubscriberId })"
                   class="btn btn-outline-primary btn-sm mt-3">
                    <i class="fas fa-eye me-1"></i>عرض بطاقة المشترك
                </a>
            </div>
        </div>
    </div>

    <!-- المولد -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-bolt text-warning me-2"></i>المولد
                </h6>
            </div>
            <div class="card-body">
                <h5 class="fw-bold">@Model.Generator?.Name</h5>
                <p class="text-muted mb-2 font-monospace">@Model.Generator?.GeneratorNumber</p>
                <div class="row g-2 mt-3">
                    <div class="col-6">
                        <div class="p-2 bg-light rounded text-center">
                            <small class="text-muted d-block">القدرة</small>
                            <strong>@Model.Generator?.PowerKVA KVA</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-light rounded text-center">
                            <small class="text-muted d-block">الأمبير الأقصى</small>
                            <strong>@Model.Generator?.MaxAmpere A</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- التفاصيل المالية -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-dollar-sign text-success me-2"></i>التفاصيل المالية
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted d-block">عدد الأمبير</small>
                            <h4 class="fw-900 mb-0 text-warning">@Model.Ampere <small>A</small></h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted d-block">سعر الأمبير</small>
                            <h4 class="fw-900 mb-0">@Model.PricePerAmpere.ToString("N0") <small>د.ع</small></h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <small class="text-muted d-block">رسوم ثابتة</small>
                            <h4 class="fw-900 mb-0">@Model.FixedFee.ToString("N0") <small>د.ع</small></h4>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-warning bg-opacity-10 rounded">
                            <small class="text-muted d-block">الخصم الشهري</small>
                            <h4 class="fw-900 mb-0 text-warning">@Model.MonthlyDiscount.ToString("N0") <small>د.ع</small></h4>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-info bg-opacity-10 rounded">
                            <small class="text-muted d-block">رسوم التركيب (مرة واحدة)</small>
                            <h4 class="fw-900 mb-0 text-info">@Model.InstallationFee.ToString("N0") <small>د.ع</small></h4>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-success bg-opacity-10 rounded d-flex justify-content-between align-items-center">
                            <div>
                                <strong>المبلغ الشهري = (@Model.Ampere × @Model.PricePerAmpere) + @Model.FixedFee - @Model.MonthlyDiscount</strong>
                            </div>
                            <h3 class="fw-900 text-success mb-0">
                                @Model.MonthlyAmount.ToString("N0") د.ع
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- معلومات إضافية -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-cog text-primary me-2"></i>معلومات إضافية
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">نوع الاشتراك</small>
                    <span class="badge bg-info">@Model.SubscriptionTypeText</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">يوم الاستحقاق</small>
                    <strong>@Model.DueDay من كل شهر</strong>
                </div>
                @if (!string.IsNullOrEmpty(Model.CabinetNumber))
                {
                    <div class="mb-3">
                        <small class="text-muted d-block">رقم الكابينة</small>
                        <strong class="font-monospace">@Model.CabinetNumber</strong>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CircuitNumber))
                {
                    <div class="mb-3">
                        <small class="text-muted d-block">رقم الدورة</small>
                        <strong class="font-monospace">@Model.CircuitNumber</strong>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.MeterNumber))
                {
                    <div class="mb-3">
                        <small class="text-muted d-block">رقم العداد</small>
                        <strong class="font-monospace">@Model.MeterNumber</strong>
                    </div>
                }
                @if (Model.NextBillingDate.HasValue)
                {
                    <div class="alert alert-warning py-2 mb-0">
                        <i class="fas fa-calendar-alt me-1"></i>
                        <strong>الفوترة القادمة:</strong>
                        @Model.NextBillingDate.Value.ToString("yyyy/MM/dd")
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Status == SubscriptionStatus.Suspended && !string.IsNullOrEmpty(Model.SuspensionReason))
{
    <div class="alert alert-warning mt-4">
        <h6 class="fw-bold mb-2">
            <i class="fas fa-pause-circle me-2"></i>سبب الإيقاف
        </h6>
        <p class="mb-0">@Model.SuspensionReason</p>
        @if (Model.SuspensionDate.HasValue)
        {
            <small class="text-muted mt-2 d-block">
                تاريخ الإيقاف: @Model.SuspensionDate.Value.ToString("yyyy/MM/dd HH:mm")
            </small>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Model.Notes))
{
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold">
                <i class="fas fa-sticky-note text-secondary me-2"></i>ملاحظات
            </h6>
        </div>
        <div class="card-body">
            <p class="mb-0">@Model.Notes</p>
        </div>
    </div>
}