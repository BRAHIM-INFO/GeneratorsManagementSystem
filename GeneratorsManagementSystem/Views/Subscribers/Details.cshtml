@model GeneratorsManagementSystem.Models.Subscriber
@{
    ViewData["Title"] = "بطاقة المشترك";
}

@section Styles {
    <style>
        .profile-card {
            background: linear-gradient(135deg, #5A67D8 0%, #7886E0 100%);
            border-radius: 20px;
            color: white;
            overflow: hidden;
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: 4px solid rgba(255,255,255,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 800;
        }

        .info-item {
            padding: 12px;
            border-radius: 10px;
            background: #f8f9fc;
            transition: all 0.2s;
        }

            .info-item:hover {
                background: #EBF4FF;
            }

        .info-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .stat-mini {
            padding: 15px;
            border-radius: 12px;
            text-align: center;
        }
    </style>
}

<!-- ═══ HEADER ═══ -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-800 mb-1">
            <i class="fas fa-address-card text-primary me-2"></i>
            بطاقة المشترك
        </h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none">
                        <i class="fas fa-home"></i>
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index")" class="text-decoration-none">المشتركين</a>
                </li>
                <li class="breadcrumb-item active">@Model.FullName</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right me-2"></i>رجوع
        </a>
        <button class="btn btn-primary" onclick="window.print()">
            <i class="fas fa-print me-2"></i>طباعة
        </button>
    </div>
</div>

<!-- ═══ PROFILE CARD ═══ -->
<div class="profile-card shadow mb-4">
    <div class="p-4">
        <div class="row align-items-center">
            <div class="col-md-2 text-center">
                <div class="profile-avatar mx-auto">
                    @Model.FullName?.FirstOrDefault()
                </div>
            </div>
            <div class="col-md-6">
                <h3 class="fw-900 mb-2">@Model.FullName</h3>
                <div class="d-flex flex-wrap gap-3">
                    <span class="badge bg-white bg-opacity-25 py-2 px-3">
                        <i class="fas fa-hashtag me-1"></i>
                        <span class="font-monospace">@Model.SubscriberNumber</span>
                    </span>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success py-2 px-3">
                            <i class="fas fa-check-circle me-1"></i>نشط
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger py-2 px-3">
                            <i class="fas fa-ban me-1"></i>غير نشط
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <span class="badge bg-white bg-opacity-25 py-2 px-3" dir="ltr">
                            <i class="fas fa-phone me-1"></i>@Model.Phone
                        </span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.FullAddress) && Model.FullAddress != "—")
                {
                    <div class="mt-3 opacity-75">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        @Model.FullAddress
                    </div>
                }
            </div>
            <div class="col-md-4">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="stat-mini bg-white bg-opacity-25">
                            <div class="fs-3 fw-900">@Model.ActiveSubscriptionsCount</div>
                            <small>اشتراك نشط</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-mini bg-white bg-opacity-25">
                            <div class="fs-3 fw-900">@Model.TotalMonthlyFees.ToString("N0")</div>
                            <small>د.ع/شهرياً</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ CONTENT ═══ -->
<div class="row g-4">

    <!-- ─── البيانات التفصيلية ─── -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-user text-primary me-2"></i>
                    البيانات الشخصية
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="info-item d-flex align-items-center gap-3">
                            <div class="info-icon" style="background:#EBF4FF;color:#5A67D8">
                                <i class="fas fa-id-card"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">رقم الهوية</small>
                                <strong>@(Model.IdNumber ?? "—")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-item d-flex align-items-center gap-3">
                            <div class="info-icon" style="background:#F0FFF4;color:#48BB78">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">الهاتف الأساسي</small>
                                <strong dir="ltr">@(Model.Phone ?? "—")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-item d-flex align-items-center gap-3">
                            <div class="info-icon" style="background:#F0FFF4;color:#48BB78">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">الهاتف الثانوي</small>
                                <strong dir="ltr">@(Model.Phone2 ?? "—")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-item d-flex align-items-center gap-3">
                            <div class="info-icon" style="background:#FFFAF0;color:#D69E2E">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">البريد الإلكتروني</small>
                                <strong dir="ltr">@(Model.Email ?? "—")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ─── الاشتراكات ─── -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-file-contract text-warning me-2"></i>
                    الاشتراكات (@(Model.Subscriptions?.Count ?? 0))
                </h6>
                <button class="btn btn-sm btn-warning" disabled title="قيد التطوير">
                    <i class="fas fa-plus me-1"></i>إضافة اشتراك
                </button>
            </div>
            <div class="card-body">
                @if (Model.Subscriptions?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>رقم العقد</th>
                                    <th>المولد</th>
                                    <th>الأمبير</th>
                                    <th>الرسوم الشهرية</th>
                                    <th>الحالة</th>
                                    <th>تاريخ البداية</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in Model.Subscriptions)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-primary font-monospace">
                                                @sub.ContractNumber
                                            </span>
                                        </td>
                                        <td>
                                            <i class="fas fa-bolt text-warning me-1"></i>
                                            @sub.Generator?.GeneratorNumber - @sub.Generator?.Name
                                        </td>
                                        <td><strong>@sub.Ampere A</strong></td>
                                        <td>
                                            <strong class="text-success">
                                                @sub.MonthlyAmount.ToString("N0") د.ع
                                            </strong>
                                        </td>
                                        <td>
                                            <span class="badge @sub.StatusBadgeClass">
                                                @sub.StatusText
                                            </span>
                                        </td>
                                        <td>
                                            <small>@sub.StartDate.ToString("yyyy/MM/dd")</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-file-contract fa-3x text-muted mb-3"></i>
                        <p class="text-muted mb-0">لا توجد اشتراكات مسجلة لهذا المشترك</p>
                        <small class="text-muted">
                            إدارة الاشتراكات ستكون متاحة قريباً
                        </small>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ─── معلومات جانبية ─── -->
    <div class="col-lg-4">

        <!-- ملخص مالي -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-wallet text-success me-2"></i>
                    الملخص المالي
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3 p-3 rounded" style="background:#F0FFF4">
                    <small class="text-muted d-block">إجمالي المدفوع</small>
                    <h4 class="fw-900 text-success mb-0">
                        @Model.TotalPaid.ToString("N0")
                        <small class="text-muted fs-6">د.ع</small>
                    </h4>
                </div>
                <div class="mb-3 p-3 rounded" style="background:#FFFAF0">
                    <small class="text-muted d-block">إجمالي المفوتر</small>
                    <h4 class="fw-900 text-warning mb-0">
                        @Model.TotalInvoiced.ToString("N0")
                        <small class="text-muted fs-6">د.ع</small>
                    </h4>
                </div>
                <div class="p-3 rounded" style="background:@(Model.Balance >= 0 ? "#EBF4FF" : "#FFF5F5")">
                    <small class="text-muted d-block">الرصيد</small>
                    <h4 class="fw-900 mb-0 @(Model.Balance >= 0 ? "text-primary" : "text-danger")">
                        @Model.Balance.ToString("N0")
                        <small class="text-muted fs-6">د.ع</small>
                    </h4>
                </div>
            </div>
        </div>

        <!-- العنوان -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-map-marker-alt text-danger me-2"></i>
                    العنوان
                </h6>
            </div>
            <div class="card-body">
                @if (Model.FullAddress != "—")
                {
                    <p class="mb-2">@Model.FullAddress</p>
                    @if (!string.IsNullOrEmpty(Model.AddressNotes))
                    {
                        <div class="alert alert-light py-2 mb-0 small">
                            <i class="fas fa-info-circle text-info me-1"></i>
                            @Model.AddressNotes
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">لم يتم إدخال العنوان</p>
                }
            </div>
        </div>

        <!-- معلومات التسجيل -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fas fa-info-circle text-info me-2"></i>
                    معلومات التسجيل
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted d-block">تاريخ التسجيل</small>
                    <strong>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</strong>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">تم بواسطة</small>
                    <strong>@(Model.CreatedBy ?? "—")</strong>
                </div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <hr />
                    <div class="mb-2">
                        <small class="text-muted d-block">آخر تحديث</small>
                        <strong>@Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block">بواسطة</small>
                        <strong>@(Model.UpdatedBy ?? "—")</strong>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Notes))
{
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold">
                <i class="fas fa-sticky-note text-secondary me-2"></i>
                ملاحظات
            </h6>
        </div>
        <div class="card-body">
            <p class="mb-0">@Model.Notes</p>
        </div>
    </div>
}