<!DOCTYPE html>
<html lang="ar" dir="rtl" data-layout="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة المولدات</title>

    <!-- Google Fonts - Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;500;600;700;800;900&display=swap"
          rel="stylesheet">

    <!-- Bootstrap 5.3 RTL -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">

    <!-- Font Awesome 6.5 -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <!-- ✅ Page Specific Styles -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="wrapper" id="mainWrapper">

        <!-- SIDEBAR -->
        @await Html.PartialAsync("_Sidebar")

        <!-- MAIN CONTENT -->
        <div class="main-content" id="mainContent">

            <!-- Top Navbar -->
            @await Html.PartialAsync("_TopNavbar")

            <!-- Page Content -->
            <div class="page-content">
                <div class="container-fluid">

                    <!-- ✅ Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show
                                        d-flex align-items-center gap-2 mb-3"
                             role="alert">
                            <i class="fas fa-check-circle"></i>
                            <span>@TempData["Success"]</span>
                            <button type="button" class="btn-close ms-auto"
                                    data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- ✅ Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show
                                        d-flex align-items-center gap-2 mb-3"
                             role="alert">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>@TempData["Error"]</span>
                            <button type="button" class="btn-close ms-auto"
                                    data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- ✅ Warning Message -->
                    @if (TempData["Warning"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show
                                        d-flex align-items-center gap-2 mb-3"
                             role="alert">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>@TempData["Warning"]</span>
                            <button type="button" class="btn-close ms-auto"
                                    data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- ✅ Page Body -->
                    @RenderBody()

                </div>
            </div>

            <!-- Footer -->
            @await Html.PartialAsync("_Footer")

        </div>
    </div>

    <!-- ════════════════════════════════════
         SCRIPTS - الترتيب مهم جداً
         ════════════════════════════════════ -->
    <!-- 1. jQuery أولاً -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- 2. Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 3. ✅ SignalR - مطلوب في كل الصفحات -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>

    <!-- 4. DataTables -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- 5. SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- 6. ApexCharts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <!-- 7. Site JS الرئيسي -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
    // تحديث بادج الكتب في الـ Sidebar
    (function updateBookBadge() {
        fetch('/Books/Alerts?daysAhead=30')
            .then(r => r.json())
            .then(res => {
                if (res.count > 0) {
                    var badges = document.querySelectorAll('.book-alerts-badge');
                    badges.forEach(b => {
                        b.textContent = res.count;
                        b.classList.remove('d-none');
                    });
                }
            })
            .catch(() => {});

        // تحديث كل دقيقتين
        setTimeout(updateBookBadge, 120000);
    })();
</script>

    <!-- 8. ✅ Page Specific Scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html> 