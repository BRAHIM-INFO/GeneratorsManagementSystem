            <!-- User -->
            <div class="dropdown">
                <button class="user-btn" data-bs-toggle="dropdown">
                    <div class="user-avatar-nav">
                        @(user?.FullName?.Substring(0, 1) ?? "م")
                    </div>
                    <div class="user-info-nav d-none d-md-block">
                        <span class="un">@(user?.FullName ?? "المستخدم")</span>
