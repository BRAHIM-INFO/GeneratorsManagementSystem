@model GeneratorsManagementSystem.Controllers.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>تسجيل الدخول - GMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * {
            font-family: 'Cairo', sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .login-card {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 24px;
            padding: 2.5rem;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }

        .login-logo {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #7367F0, #9E95F5);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 1.75rem;
            color: white;
            box-shadow: 0 10px 30px rgba(115,103,240,0.4);
        }

        .login-title {
            color: white;
            font-size: 1.5rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 0.5rem;
        }

        .login-subtitle {
            color: rgba(255,255,255,0.6);
            text-align: center;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

        .form-label {
            color: rgba(255,255,255,0.8);
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-control {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 12px;
            color: white;
            padding: 0.75rem 1rem;
            font-family: 'Cairo', sans-serif;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background: rgba(255,255,255,0.12);
                border-color: #7367F0;
                box-shadow: 0 0 0 3px rgba(115,103,240,0.25);
                color: white;
            }

            .form-control::placeholder {
                color: rgba(255,255,255,0.35);
            }

        .input-group .input-group-text {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            color: rgba(255,255,255,0.6);
            border-radius: 0 12px 12px 0;
            border-right: none;
            cursor: pointer;
        }

        .input-group .form-control {
            border-radius: 12px 0 0 12px;
            border-left: none;
        }

        .btn-login {
            background: linear-gradient(135deg, #7367F0, #9E95F5);
            border: none;
            border-radius: 12px;
            color: white;
            width: 100%;
            padding: 0.85rem;
            font-size: 1rem;
            font-weight: 700;
            font-family: 'Cairo', sans-serif;
            transition: all 0.3s ease;
            margin-top: 1rem;
            box-shadow: 0 8px 20px rgba(115,103,240,0.35);
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 25px rgba(115,103,240,0.5);
                color: white;
            }

        .remember-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }

        .form-check-input {
            background-color: rgba(255,255,255,0.1);
            border-color: rgba(255,255,255,0.3);
        }

            .form-check-input:checked {
                background-color: #7367F0;
                border-color: #7367F0;
            }

        .form-check-label {
            color: rgba(255,255,255,0.7);
            font-size: 0.875rem;
        }

        .forgot-link {
            color: #9E95F5;
            font-size: 0.875rem;
            text-decoration: none;
            transition: color 0.2s;
        }

            .forgot-link:hover {
                color: #7367F0;
            }

        .divider {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 1.5rem 0;
            color: rgba(255,255,255,0.4);
            font-size: 0.8rem;
        }

            .divider::before, .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: rgba(255,255,255,0.15);
            }

        .alert-danger {
            background: rgba(234,84,85,0.15);
            border: 1px solid rgba(234,84,85,0.3);
            color: #FF8A8B;
            border-radius: 10px;
            font-size: 0.875rem;
        }

        .demo-info {
            background: rgba(115,103,240,0.15);
            border: 1px solid rgba(115,103,240,0.3);
            border-radius: 10px;
            padding: 0.75rem 1rem;
            margin-top: 1.5rem;
            color: rgba(255,255,255,0.7);
            font-size: 0.8rem;
        }

        .back-link {
            display: block;
            text-align: center;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            margin-top: 1.5rem;
            font-size: 0.85rem;
            transition: color 0.2s;
        }

            .back-link:hover {
                color: rgba(255,255,255,0.8);
            }
    </style>
</head>
<body>
    <div class="login-card">
        <!-- Logo -->
        <div class="login-logo">
            <i class="fas fa-bolt"></i>
        </div>

        <!-- Title -->
        <h2 class="login-title">نظام إدارة المولدات</h2>
        <p class="login-subtitle">سجّل دخولك للوصول إلى النظام</p>

        <!-- Error Messages -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors)
                            .Select(e => e.ErrorMessage))
                {
                    <div><i class="fas fa-exclamation-circle me-2"></i>@error</div>
                }
            </div>
        }

        <!-- Login Form -->
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label class="form-label">
                    <i class="fas fa-envelope me-2"></i>البريد الإلكتروني
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="admin@gms.com"
                       autocomplete="email"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    <i class="fas fa-lock me-2"></i>كلمة المرور
                </label>
                <div class="input-group">
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           id="passwordInput"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required />
                    <span class="input-group-text" onclick="togglePassword()">
                        <i class="fas fa-eye" id="passwordToggleIcon"></i>
                    </span>
                </div>
            </div>

            <div class="remember-row">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        تذكرني
                    </label>
                </div>
                <a href="#" class="forgot-link">نسيت كلمة المرور؟</a>
            </div>

            <button type="submit" class="btn-login">
                <i class="fas fa-sign-in-alt me-2"></i>
                تسجيل الدخول
            </button>
        </form>

        <!-- Demo Info -->
        <div class="demo-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>بيانات الدخول التجريبي:</strong><br>
            البريد: <code>admin@gms.com</code><br>
            كلمة المرور: <code>Admin@123456</code>
        </div>

        <!-- Back Link -->
        <a href="@Url.Action("Welcome", "Home")" class="back-link">
            <i class="fas fa-arrow-right me-2"></i>العودة للصفحة الرئيسية
        </a>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('passwordToggleIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
    </script>
</body>
</html>