@model GeneratorsManagementSystem.Models.ViewModels.Settings.SubscriptionSettingsViewModel
@{
    ViewData["Title"] = "إعدادات الاشتراكات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" />
}

<div class="settings-page">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-file-invoice text-purple"></i>
                إعدادات الاشتراكات
            </h2>
            <p class="page-subtitle text-muted mb-0">الرسوم الافتراضية وفترات الفوترة</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Subscriptions" method="post" id="subForm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <ul class="nav nav-tabs settings-tabs mb-4">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#sub-numbering" type="button">
                    <i class="fas fa-hashtag"></i> الترقيم
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sub-fees" type="button">
                    <i class="fas fa-money-bill"></i> الرسوم
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sub-billing" type="button">
                    <i class="fas fa-calendar-alt"></i> الفوترة
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sub-penalties" type="button">
                    <i class="fas fa-exclamation-circle"></i> الغرامات والخصومات
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sub-contracts" type="button">
                    <i class="fas fa-file-signature"></i> العقود والتنبيهات
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- الترقيم -->
            <div class="tab-pane fade show active" id="sub-numbering">
                <div class="settings-card">
                    <div class="settings-card-header bg-primary-gradient">
                        <h5><i class="fas fa-hashtag"></i> ترقيم المشتركين</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="SubscriberNumberPrefix" class="form-label"></label>
                                <input asp-for="SubscriberNumberPrefix" class="form-control" dir="ltr" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SubscriberNumberLength" class="form-label"></label>
                                <input asp-for="SubscriberNumberLength" type="number" class="form-control" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input asp-for="IncludeYearInNumber" class="form-check-input" />
                                    <label asp-for="IncludeYearInNumber" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="preview-box">
                                    <label class="form-label">معاينة الرقم:</label>
                                    <div class="preview-value" id="subNumPreview">SUB-26-0001</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- الرسوم -->
            <div class="tab-pane fade" id="sub-fees">
                <div class="settings-card">
                    <div class="settings-card-header bg-success-gradient">
                        <h5><i class="fas fa-money-bill"></i> الرسوم الافتراضية</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DefaultSubscriptionType" class="form-label"></label>
                                <select asp-for="DefaultSubscriptionType" class="form-select">
                                    <option value="Monthly">شهري</option>
                                    <option value="Yearly">سنوي</option>
                                    <option value="PayAsYouGo">حسب الاستهلاك</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DefaultInstallationFee" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultInstallationFee" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DefaultMonthlyFee" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultMonthlyFee" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DefaultPricePerAmpere" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultPricePerAmpere" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DefaultPricePerKwh" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultPricePerKwh" type="number" step="0.001" class="form-control" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- الفوترة -->
            <div class="tab-pane fade" id="sub-billing">
                <div class="settings-card">
                    <div class="settings-card-header bg-info-gradient">
                        <h5><i class="fas fa-calendar-alt"></i> دورة الفوترة</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="BillingDayOfMonth" class="form-label"></label>
                                <input asp-for="BillingDayOfMonth" type="number" min="1" max="28" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GracePeriodDays" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="GracePeriodDays" type="number" class="form-control" />
                                    <span class="input-group-text">يوم</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="AutoSuspendOverdue" class="form-check-input" />
                                    <label asp-for="AutoSuspendOverdue" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SuspendAfterDays" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="SuspendAfterDays" type="number" class="form-control" />
                                    <span class="input-group-text">يوم</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- الغرامات والخصومات -->
            <div class="tab-pane fade" id="sub-penalties">
                <div class="settings-card mb-3">
                    <div class="settings-card-header bg-danger-gradient">
                        <h5><i class="fas fa-exclamation-triangle"></i> غرامات التأخير</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="ApplyLateFees" class="form-check-input" />
                                    <label asp-for="ApplyLateFees" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LateFeeAmount" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="LateFeeAmount" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LateFeePercentage" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="LateFeePercentage" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="settings-card-header bg-success-gradient">
                        <h5><i class="fas fa-percentage"></i> خصومات الدفع المبكر</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="AllowEarlyPaymentDiscount" class="form-check-input" />
                                    <label asp-for="AllowEarlyPaymentDiscount" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EarlyPaymentDiscountPercentage" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="EarlyPaymentDiscountPercentage" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EarlyPaymentDaysBeforeDue" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="EarlyPaymentDaysBeforeDue" type="number" class="form-control" />
                                    <span class="input-group-text">يوم</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- العقود والتنبيهات -->
            <div class="tab-pane fade" id="sub-contracts">
                <div class="settings-card mb-3">
                    <div class="settings-card-header bg-warning-gradient">
                        <h5><i class="fas fa-file-signature"></i> إعدادات العقود</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DefaultContractDurationMonths" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultContractDurationMonths" type="number" class="form-control" />
                                    <span class="input-group-text">شهر</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DefaultDepositAmount" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultDepositAmount" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="RequireDeposit" class="form-check-input" />
                                    <label asp-for="RequireDeposit" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="settings-card-header bg-purple-gradient">
                        <h5><i class="fas fa-bell"></i> تذكيرات الدفع</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="EnablePaymentReminders" class="form-check-input" />
                                    <label asp-for="EnablePaymentReminders" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReminderBeforeDueDays" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="ReminderBeforeDueDays" type="number" class="form-control" />
                                    <span class="input-group-text">يوم</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReminderAfterDueDays" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="ReminderAfterDueDays" type="number" class="form-control" />
                                    <span class="input-group-text">يوم</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="settings-actions mt-4">
            <button type="submit" class="btn btn-purple btn-lg">
                <i class="fas fa-save"></i> حفظ الإعدادات
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg">
                إلغاء <i class="fas fa-times"></i>
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateSubPreview() {
            var prefix = $('#SubscriberNumberPrefix').val() || 'SUB';
            var length = parseInt($('#SubscriberNumberLength').val()) || 4;
            var includeYear = $('#IncludeYearInNumber').is(':checked');
            var year = new Date().getFullYear().toString().substring(2);
            var num = '1'.padStart(length, '0');
            var preview = prefix + '-' + (includeYear ? year + '-' : '') + num;
            $('#subNumPreview').text(preview);
        }

        $('#SubscriberNumberPrefix, #SubscriberNumberLength, #IncludeYearInNumber').on('input change', updateSubPreview);
        $(document).ready(updateSubPreview);
    </script>
}