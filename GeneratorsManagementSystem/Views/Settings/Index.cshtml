@model GeneratorsManagementSystem.Models.ViewModels.Settings.SettingsDashboardViewModel
@{
    ViewData["Title"] = "إعدادات النظام";
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" />
}

<div class="settings-page">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-cogs text-purple"></i>
                إعدادات النظام
            </h2>
            <p class="page-subtitle text-muted mb-0">إدارة جميع إعدادات النظام من مكان واحد</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-secondary" onclick="location.reload()">
                <i class="fas fa-sync-alt"></i> تحديث
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="stat-card stat-primary">
                <div class="stat-icon"><i class="fas fa-users"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.TotalUsers</div>
                    <div class="stat-label">إجمالي المستخدمين</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card stat-success">
                <div class="stat-icon"><i class="fas fa-user-check"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.ActiveUsers</div>
                    <div class="stat-label">المستخدمون النشطون</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card stat-warning">
                <div class="stat-icon"><i class="fas fa-user-shield"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.TotalRoles</div>
                    <div class="stat-label">الأدوار المعرفة</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card stat-info">
                <div class="stat-icon"><i class="fas fa-sliders-h"></i></div>
                <div class="stat-content">
                    <div class="stat-value">@Model.TotalSettings</div>
                    <div class="stat-label">إعدادات محفوظة</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Organization Card -->
    <div class="org-card mb-4">
        <div class="org-info">
            <div class="org-logo">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" alt="Logo" />
                }
                else
                {
                    <i class="fas fa-building"></i>
                }
            </div>
            <div class="org-details">
                <h3>@Model.OrganizationName</h3>
                <p>الإصدار @Model.SystemVersion • آخر نسخة احتياطية: @Model.LastBackup.ToString("yyyy/MM/dd")</p>
            </div>
        </div>
        <div class="org-actions">
            <a href="@Url.Action("Organization")" class="btn btn-purple">
                <i class="fas fa-edit"></i> تعديل بيانات المؤسسة
            </a>
        </div>
    </div>

    <!-- Settings Cards Grid -->
    <div class="section-title mb-3">
        <h4><i class="fas fa-th-large"></i> أقسام الإعدادات</h4>
    </div>

    <div class="row g-3">
        @foreach (var card in Model.Cards)
        {
            <div class="col-lg-4 col-md-6">
                <a href="@card.Url" class="setting-card-link">
                    <div class="setting-card setting-@card.Color">
                        <div class="setting-card-icon">
                            <i class="fas @card.Icon"></i>
                        </div>
                        <div class="setting-card-body">
                            <h5>@card.Title</h5>
                            <p>@card.Description</p>
                        </div>
                        <div class="setting-card-arrow">
                            <i class="fas fa-chevron-left"></i>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>