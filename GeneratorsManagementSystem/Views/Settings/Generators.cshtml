@model GeneratorsManagementSystem.Models.ViewModels.Settings.GeneratorSettingsViewModel
@{
    ViewData["Title"] = "إعدادات المولدات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" />
}

<div class="settings-page">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-bolt text-purple"></i>
                إعدادات المولدات
            </h2>
            <p class="page-subtitle text-muted mb-0">القيم الافتراضية وتنبيهات المولدات</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Generators" method="post" id="generatorForm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <ul class="nav nav-tabs settings-tabs mb-4">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#numbering" type="button">
                    <i class="fas fa-hashtag"></i> الترقيم
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#fuel" type="button">
                    <i class="fas fa-gas-pump"></i> الوقود
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#maintenance" type="button">
                    <i class="fas fa-tools"></i> الصيانة
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#specifications" type="button">
                    <i class="fas fa-cog"></i> المواصفات
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#monitoring" type="button">
                    <i class="fas fa-desktop"></i> المراقبة
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- ترقيم المولدات -->
            <div class="tab-pane fade show active" id="numbering">
                <div class="settings-card">
                    <div class="settings-card-header bg-primary-gradient">
                        <h5><i class="fas fa-hashtag"></i> إعدادات ترقيم المولدات</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="GeneratorNumberPrefix" class="form-label"></label>
                                <input asp-for="GeneratorNumberPrefix" class="form-control" dir="ltr" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="GeneratorNumberLength" class="form-label"></label>
                                <input asp-for="GeneratorNumberLength" type="number" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="GeneratorNumberStart" class="form-label"></label>
                                <input asp-for="GeneratorNumberStart" type="number" class="form-control" />
                            </div>
                            <div class="col-12">
                                <div class="preview-box">
                                    <label class="form-label">معاينة الرقم:</label>
                                    <div class="preview-value" id="genNumPreview">GEN-01</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- الوقود -->
            <div class="tab-pane fade" id="fuel">
                <div class="settings-card mb-3">
                    <div class="settings-card-header bg-danger-gradient">
                        <h5><i class="fas fa-gas-pump"></i> إعدادات الوقود الافتراضية</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DefaultFuelType" class="form-label"></label>
                                <select asp-for="DefaultFuelType" class="form-select">
                                    <option value="Diesel">ديزل</option>
                                    <option value="Gasoline">بنزين</option>
                                    <option value="Gas">غاز</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FuelPricePerLiter" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="FuelPricePerLiter" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">د.ل</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DefaultFuelTankCapacity" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultFuelTankCapacity" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">لتر</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DefaultFuelConsumptionRate" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultFuelConsumptionRate" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">لتر/ساعة</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="settings-card-header bg-warning-gradient">
                        <h5><i class="fas fa-bell"></i> تنبيهات الوقود</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="LowFuelAlertPercentage" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="LowFuelAlertPercentage" type="number" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CriticalFuelAlertPercentage" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="CriticalFuelAlertPercentage" type="number" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="EnableFuelAlerts" class="form-check-input" />
                                    <label asp-for="EnableFuelAlerts" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input asp-for="EnableEmailFuelAlerts" class="form-check-input" />
                                    <label asp-for="EnableEmailFuelAlerts" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input asp-for="EnableSmsFuelAlerts" class="form-check-input" />
                                    <label asp-for="EnableSmsFuelAlerts" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- الصيانة -->
            <div class="tab-pane fade" id="maintenance">
                <div class="settings-card">
                    <div class="settings-card-header bg-info-gradient">
                        <h5><i class="fas fa-tools"></i> إعدادات الصيانة</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DefaultMaintenanceIntervalHours" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultMaintenanceIntervalHours" type="number" class="form-control" />
                                    <span class="input-group-text">ساعة</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MaintenanceAlertBeforeHours" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="MaintenanceAlertBeforeHours" type="number" class="form-control" />
                                    <span class="input-group-text">ساعة</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="EnableMaintenanceAlerts" class="form-check-input" />
                                    <label asp-for="EnableMaintenanceAlerts" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- المواصفات -->
            <div class="tab-pane fade" id="specifications">
                <div class="settings-card mb-3">
                    <div class="settings-card-header bg-purple-gradient">
                        <h5><i class="fas fa-cog"></i> المواصفات الافتراضية</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DefaultVoltage" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultVoltage" type="number" step="0.1" class="form-control" />
                                    <span class="input-group-text">V</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DefaultFrequency" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DefaultFrequency" type="number" step="0.1" class="form-control" />
                                    <span class="input-group-text">Hz</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card">
                    <div class="settings-card-header bg-danger-gradient">
                        <h5><i class="fas fa-exclamation-triangle"></i> حدود التشغيل الآمن</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="MaxTemperature" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="MaxTemperature" type="number" step="0.1" class="form-control" />
                                    <span class="input-group-text">°C</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MinOilPressure" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="MinOilPressure" type="number" step="0.1" class="form-control" />
                                    <span class="input-group-text">PSI</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxLoadPercentage" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="MaxLoadPercentage" type="number" step="0.1" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- المراقبة -->
            <div class="tab-pane fade" id="monitoring">
                <div class="settings-card">
                    <div class="settings-card-header bg-success-gradient">
                        <h5><i class="fas fa-desktop"></i> إعدادات المراقبة</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="EnableRealTimeMonitoring" class="form-check-input" />
                                    <label asp-for="EnableRealTimeMonitoring" class="form-check-label"></label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MonitoringIntervalSeconds" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="MonitoringIntervalSeconds" type="number" class="form-control" />
                                    <span class="input-group-text">ثانية</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="AutoLogGeneratorEvents" class="form-check-input" />
                                    <label asp-for="AutoLogGeneratorEvents" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="settings-actions mt-4">
            <button type="submit" class="btn btn-purple btn-lg">
                <i class="fas fa-save"></i> حفظ الإعدادات
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg">
                إلغاء <i class="fas fa-times"></i>
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateGenPreview() {
            var prefix = $('#GeneratorNumberPrefix').val() || 'GEN';
            var length = parseInt($('#GeneratorNumberLength').val()) || 2;
            var start = parseInt($('#GeneratorNumberStart').val()) || 1;
            var num = String(start).padStart(length, '0');
            $('#genNumPreview').text(prefix + '-' + num);
        }

        $('#GeneratorNumberPrefix, #GeneratorNumberLength, #GeneratorNumberStart').on('input change', updateGenPreview);
        $(document).ready(updateGenPreview);
    </script>
}