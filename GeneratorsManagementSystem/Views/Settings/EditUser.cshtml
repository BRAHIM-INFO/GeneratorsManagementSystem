@model GeneratorsManagementSystem.Models.ViewModels.Settings.UserFormViewModel
@{
    ViewData["Title"] = "تعديل المستخدم";
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" />
}

<div class="settings-page">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-user-edit text-purple"></i>
                تعديل المستخدم
            </h2>
            <p class="page-subtitle text-muted mb-0">@Model.FullName</p>
        </div>
        <a href="@Url.Action("Users")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>

    <form asp-action="EditUser" method="post" enctype="multipart/form-data" id="userForm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="ProfilePicture" type="hidden" />

        <div class="row g-3">
            <div class="col-md-4">
                <div class="settings-card">
                    <div class="settings-card-header bg-purple-gradient">
                        <h5><i class="fas fa-camera"></i> الصورة الشخصية</h5>
                    </div>
                    <div class="settings-card-body text-center">
                        <div class="profile-preview" id="profilePreview">
                            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                            {
                                <img src="@Model.ProfilePicture" alt="@Model.FullName" />
                            }
                            else
                            {
                                <i class="fas fa-user"></i>
                                <p>لا توجد صورة</p>
                            }
                        </div>
                        <label class="btn btn-outline-purple mt-3">
                            <i class="fas fa-upload"></i> تغيير الصورة
                            <input asp-for="ProfilePictureFile" type="file" accept="image/*" hidden onchange="previewProfile(this)" />
                        </label>
                    </div>
                </div>

                <div class="settings-card mt-3">
                    <div class="settings-card-header bg-success-gradient">
                        <h5><i class="fas fa-toggle-on"></i> حالة الحساب</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"><strong>حساب نشط</strong></label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="EmailConfirmed" class="form-check-input" />
                            <label asp-for="EmailConfirmed" class="form-check-label"><strong>البريد مؤكد</strong></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="settings-card">
                    <div class="settings-card-header bg-primary-gradient">
                        <h5><i class="fas fa-info-circle"></i> البيانات الأساسية</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="FullName" class="form-label"><span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label"><span class="text-danger">*</span></label>
                                <input asp-for="UserName" class="form-control" dir="ltr" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"><span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" dir="ltr" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" dir="ltr" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Language" class="form-label"></label>
                                <select asp-for="Language" class="form-select">
                                    <option value="ar">العربية</option>
                                    <option value="en">English</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Department" class="form-label"></label>
                                <input asp-for="Department" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="JobTitle" class="form-label"></label>
                                <input asp-for="JobTitle" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card mt-3">
                    <div class="settings-card-header bg-warning-gradient">
                        <h5><i class="fas fa-lock"></i> تغيير كلمة المرور (اختياري)</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> اترك الحقول فارغة إذا لم ترغب في تغيير كلمة المرور
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">كلمة المرور الجديدة</label>
                                <input asp-for="Password" class="form-control" type="password" id="passwordField" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-card mt-3">
                    <div class="settings-card-header bg-info-gradient">
                        <h5><i class="fas fa-user-shield"></i> الأدوار والصلاحيات</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-2">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <div class="col-md-4">
                                    <div class="role-checkbox">
                                        <input type="checkbox"
                                               name="SelectedRoles"
                                               value="@role.Name"
                                               id="role_@role.Id"
                                               class="form-check-input"
                                               @(Model.SelectedRoles.Contains(role.Name) ? "checked" : "") />
                                        <label for="role_@role.Id" class="role-label">
                                            <i class="fas fa-user-tag"></i>
                                            @role.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="settings-actions mt-4">
            <button type="submit" class="btn btn-purple btn-lg">
                <i class="fas fa-save"></i> حفظ التعديلات
            </button>
            <a href="@Url.Action("Users")" class="btn btn-outline-secondary btn-lg">
                <i class="fas fa-times"></i> إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewProfile(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    $('#profilePreview').html(`<img src="${e.target.result}" alt="Profile" />`);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}