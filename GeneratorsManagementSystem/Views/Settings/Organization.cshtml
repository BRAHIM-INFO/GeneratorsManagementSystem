@model GeneratorsManagementSystem.Models.ViewModels.Settings.OrganizationSettingsViewModel
@{
    ViewData["Title"] = "بيانات المؤسسة";
}

@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" />
}

<div class="settings-page">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-building text-purple"></i>
                بيانات المؤسسة
            </h2>
            <p class="page-subtitle text-muted mb-0">إدارة معلومات وشعار المؤسسة</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Organization" method="post" enctype="multipart/form-data" id="orgSettingsForm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="LogoPath" type="hidden" />
        <input asp-for="FaviconPath" type="hidden" />

        <ul class="nav nav-tabs settings-tabs mb-4">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#basic-info" type="button">
                    <i class="fas fa-info-circle"></i> البيانات الأساسية
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#contact" type="button">
                    <i class="fas fa-address-book"></i> معلومات الاتصال
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#address" type="button">
                    <i class="fas fa-map-marker-alt"></i> العنوان
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#legal" type="button">
                    <i class="fas fa-file-contract"></i> البيانات القانونية
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#social" type="button">
                    <i class="fas fa-share-alt"></i> وسائل التواصل
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Tab 1: البيانات الأساسية -->
            <div class="tab-pane fade show active" id="basic-info">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="settings-card h-100">
                            <div class="settings-card-header bg-purple-gradient">
                                <h5><i class="fas fa-image"></i> شعار المؤسسة</h5>
                            </div>
                            <div class="settings-card-body text-center">
                                <div class="logo-preview" id="logoPreview">
                                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                                    {
                                        <img src="@Model.LogoPath" alt="Logo" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-building"></i>
                                        <p>لا يوجد شعار</p>
                                    }
                                </div>
                                <div class="mt-3">
                                    <label class="btn btn-outline-purple">
                                        <i class="fas fa-upload"></i> رفع شعار
                                        <input asp-for="LogoFile" type="file" accept="image/*" hidden onchange="previewLogo(this)" />
                                    </label>
                                </div>
                                <small class="text-muted d-block mt-2">PNG, JPG (أقصى 2MB)</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="settings-card h-100">
                            <div class="settings-card-header bg-primary-gradient">
                                <h5><i class="fas fa-info-circle"></i> المعلومات الأساسية</h5>
                            </div>
                            <div class="settings-card-body">
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label asp-for="OrganizationName" class="form-label">
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input asp-for="OrganizationName" class="form-control" />
                                        <span asp-validation-for="OrganizationName" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="OrganizationNameEn" class="form-label"></label>
                                        <input asp-for="OrganizationNameEn" class="form-control" dir="ltr" />
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="Slogan" class="form-label"></label>
                                        <textarea asp-for="Slogan" class="form-control" rows="2"></textarea>
                                    </div>
                                    <div class="col-md-12">
                                        <label asp-for="AboutUs" class="form-label"></label>
                                        <textarea asp-for="AboutUs" class="form-control" rows="4"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 2: معلومات الاتصال -->
            <div class="tab-pane fade" id="contact">
                <div class="settings-card">
                    <div class="settings-card-header bg-info-gradient">
                        <h5><i class="fas fa-address-book"></i> معلومات الاتصال</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" dir="ltr" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Website" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-globe"></i></span>
                                    <input asp-for="Website" class="form-control" dir="ltr" placeholder="https://" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Phone1" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    <input asp-for="Phone1" class="form-control" dir="ltr" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Phone2" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone-alt"></i></span>
                                    <input asp-for="Phone2" class="form-control" dir="ltr" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Fax" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-fax"></i></span>
                                    <input asp-for="Fax" class="form-control" dir="ltr" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 3: العنوان -->
            <div class="tab-pane fade" id="address">
                <div class="settings-card">
                    <div class="settings-card-header bg-success-gradient">
                        <h5><i class="fas fa-map-marker-alt"></i> عنوان المؤسسة</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Country" class="form-label"></label>
                                <input asp-for="Country" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="District" class="form-label"></label>
                                <input asp-for="District" class="form-control" />
                            </div>
                            <div class="col-md-9">
                                <label asp-for="Address" class="form-label"></label>
                                <input asp-for="Address" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="PostalCode" class="form-label"></label>
                                <input asp-for="PostalCode" class="form-control" />
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Notes" class="form-label"></label>
                                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 4: البيانات القانونية -->
            <div class="tab-pane fade" id="legal">
                <div class="settings-card">
                    <div class="settings-card-header bg-warning-gradient">
                        <h5><i class="fas fa-file-contract"></i> البيانات القانونية والضريبية</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="TaxNumber" class="form-label"></label>
                                <input asp-for="TaxNumber" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CommercialRegister" class="form-label"></label>
                                <input asp-for="CommercialRegister" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LicenseNumber" class="form-label"></label>
                                <input asp-for="LicenseNumber" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 5: وسائل التواصل الاجتماعي -->
            <div class="tab-pane fade" id="social">
                <div class="settings-card">
                    <div class="settings-card-header bg-danger-gradient">
                        <h5><i class="fas fa-share-alt"></i> وسائل التواصل الاجتماعي</h5>
                    </div>
                    <div class="settings-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Facebook" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white"><i class="fab fa-facebook-f"></i></span>
                                    <input asp-for="Facebook" class="form-control" dir="ltr" placeholder="https://facebook.com/..." />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Twitter" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-info text-white"><i class="fab fa-twitter"></i></span>
                                    <input asp-for="Twitter" class="form-control" dir="ltr" placeholder="https://twitter.com/..." />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Instagram" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-danger text-white"><i class="fab fa-instagram"></i></span>
                                    <input asp-for="Instagram" class="form-control" dir="ltr" placeholder="https://instagram.com/..." />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LinkedIn" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white"><i class="fab fa-linkedin-in"></i></span>
                                    <input asp-for="LinkedIn" class="form-control" dir="ltr" placeholder="https://linkedin.com/..." />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="WhatsApp" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white"><i class="fab fa-whatsapp"></i></span>
                                    <input asp-for="WhatsApp" class="form-control" dir="ltr" placeholder="+218 XX XXX XXXX" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="settings-actions mt-4">
            <button type="submit" class="btn btn-purple btn-lg">
                <i class="fas fa-save"></i> حفظ البيانات
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg">
                <i class="fas fa-times"></i> إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/settings.js"></script>
}